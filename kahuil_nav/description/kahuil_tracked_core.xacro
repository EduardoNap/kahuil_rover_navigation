<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="inertial_macros.xacro"/>

    <!-- ==================== DIMENSIONS ==================== -->
    <!-- Adjust these properties to match the real robot       -->

    <!-- Chassis (main body box) -->
    <xacro:property name="chassis_length" value="0.45"/>
    <xacro:property name="chassis_width" value="0.30"/>
    <xacro:property name="chassis_height" value="0.15"/>
    <xacro:property name="chassis_mass" value="12.0"/>

    <!-- Track / wheel properties -->
    <xacro:property name="wheel_radius" value="0.075"/>
    <xacro:property name="track_width" value="0.08"/>
    <xacro:property name="track_length" value="0.35"/>
    <xacro:property name="wheel_mass" value="1.5"/>

    <!-- Wheel placement -->
    <xacro:property name="wheel_offset_x" value="${chassis_length/2 - wheel_radius}"/>
    <xacro:property name="wheel_offset_y" value="${chassis_width/2 + track_width/2}"/>
    <xacro:property name="wheel_offset_z" value="0.0"/>

    <!-- Ground clearance offset (chassis bottom above ground) -->
    <xacro:property name="ground_clearance" value="0.0"/>

    <!-- ==================== MATERIALS ==================== -->

    <material name="white">
        <color rgba="1 1 1 1"/>
    </material>

    <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1"/>
    </material>

    <material name="blue">
        <color rgba="0.2 0.2 1 1"/>
    </material>

    <material name="black">
        <color rgba="0 0 0 1"/>
    </material>

    <material name="red">
        <color rgba="1 0 0 1"/>
    </material>

    <!-- ==================== BASE LINK ==================== -->

    <link name="base_link">
    </link>

    <!-- ==================== BASE FOOTPRINT ==================== -->

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_link"/>
        <child link="base_footprint"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="base_footprint">
    </link>

    <!-- ==================== CHASSIS ==================== -->
    <!-- Chassis is offset so base_link sits at the center of the wheel axis -->

    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis"/>
        <origin xyz="${-chassis_length/2 + wheel_offset_x} 0 ${ground_clearance}"/>
    </joint>

    <link name="chassis">
        <!-- Main body box -->
        <visual>
            <origin xyz="${chassis_length/2} 0 ${chassis_height/2}" rpy="0 0 0"/>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
            <material name="dark_grey"/>
        </visual>
        <collision>
            <origin xyz="${chassis_length/2} 0 ${chassis_height/2}" rpy="0 0 0"/>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}">
            <origin xyz="${chassis_length/2} 0 ${chassis_height/2}" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <gazebo reference="chassis">
        <material>Gazebo/DarkGrey</material>
    </gazebo>

    <!-- ==================== TRACK VISUAL MACRO ==================== -->
    <!-- Each track is visualized as: front sprocket + rear sprocket + connecting box -->

    <xacro:macro name="track_visual" params="prefix y_offset">
        <joint name="${prefix}_track_joint" type="fixed">
            <parent link="chassis"/>
            <child link="${prefix}_track"/>
            <origin xyz="0 ${y_offset} ${-ground_clearance - wheel_radius}" rpy="0 0 0"/>
        </joint>

        <link name="${prefix}_track">
            <!-- Front sprocket -->
            <visual>
                <origin xyz="${chassis_length - wheel_radius} 0 ${wheel_radius}" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${track_width}"/>
                </geometry>
                <material name="black"/>
            </visual>
            <!-- Rear sprocket -->
            <visual>
                <origin xyz="${wheel_radius} 0 ${wheel_radius}" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${track_width}"/>
                </geometry>
                <material name="black"/>
            </visual>
            <!-- Top track run -->
            <visual>
                <origin xyz="${chassis_length/2} 0 ${wheel_radius*2}" rpy="0 0 0"/>
                <geometry>
                    <box size="${track_length} ${track_width} ${wheel_radius*0.15}"/>
                </geometry>
                <material name="black"/>
            </visual>
            <!-- Bottom track run -->
            <visual>
                <origin xyz="${chassis_length/2} 0 0" rpy="0 0 0"/>
                <geometry>
                    <box size="${track_length} ${track_width} ${wheel_radius*0.15}"/>
                </geometry>
                <material name="black"/>
            </visual>
            <!-- Side plate (track body fill) -->
            <visual>
                <origin xyz="${chassis_length/2} 0 ${wheel_radius}" rpy="0 0 0"/>
                <geometry>
                    <box size="${track_length} ${track_width} ${wheel_radius*2}"/>
                </geometry>
                <material name="black"/>
            </visual>
        </link>

        <gazebo reference="${prefix}_track">
            <material>Gazebo/Black</material>
        </gazebo>
    </xacro:macro>

    <!-- Instantiate left and right track visuals -->
    <xacro:track_visual prefix="left" y_offset="${wheel_offset_y}"/>
    <xacro:track_visual prefix="right" y_offset="${-wheel_offset_y}"/>

    <!-- ==================== DRIVE WHEEL MACRO ==================== -->

    <xacro:macro name="drive_wheel" params="prefix y_sign">
        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_wheel"/>
            <origin xyz="0 ${y_sign * wheel_offset_y} 0" rpy="${-y_sign * pi/2} 0 0"/>
            <axis xyz="0 0 ${y_sign}"/>
        </joint>

        <link name="${prefix}_wheel">
            <collision>
                <geometry>
                    <sphere radius="${wheel_radius}"/>
                </geometry>
            </collision>
            <xacro:inertial_cylinder mass="${wheel_mass}" length="${track_width}" radius="${wheel_radius}">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
        </link>

        <gazebo reference="${prefix}_wheel">
            <mu1 value="1.5"/>
            <mu2 value="1.5"/>
            <kp>1000000.0</kp>
            <kd>100.0</kd>
        </gazebo>
    </xacro:macro>

    <xacro:drive_wheel prefix="left" y_sign="1"/>
    <xacro:drive_wheel prefix="right" y_sign="-1"/>

    <!-- ==================== FRONT IDLER WHEELS (support at front of tracks) ==================== -->
    <!-- Same radius as drive wheels so they touch ground. Low friction for skid-steering. -->

    <xacro:property name="idler_mass" value="0.1"/>
    <xacro:property name="front_idler_x" value="${chassis_length - wheel_radius - (chassis_length/2 - wheel_offset_x)}"/>

    <xacro:macro name="idler_wheel" params="prefix side x_pos y_pos">
        <joint name="${prefix}_${side}_idler_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_${side}_idler"/>
            <origin xyz="${x_pos} ${y_pos} 0" rpy="${-pi/2} 0 0"/>
            <axis xyz="0 0 1"/>
        </joint>

        <link name="${prefix}_${side}_idler">
            <collision>
                <geometry>
                    <sphere radius="${wheel_radius}"/>
                </geometry>
            </collision>
            <xacro:inertial_sphere mass="${idler_mass}" radius="${wheel_radius}">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_sphere>
        </link>

        <gazebo reference="${prefix}_${side}_idler">
            <mu1 value="0.01"/>
            <mu2 value="0.01"/>
            <kp>1000000.0</kp>
            <kd>100.0</kd>
        </gazebo>
    </xacro:macro>

    <xacro:idler_wheel prefix="front" side="left"  x_pos="${front_idler_x}" y_pos="${wheel_offset_y}"/>
    <xacro:idler_wheel prefix="front" side="right" x_pos="${front_idler_x}" y_pos="${-wheel_offset_y}"/>

</robot>
