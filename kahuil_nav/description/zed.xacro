<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ZED 2i mount position (relative to base_link, which is at wheel-axle height) -->
    <xacro:property name="zed_x" value="0.15"/>
    <xacro:property name="zed_y" value="0.0"/>
    <xacro:property name="zed_z" value="0.17"/>

    <joint name="zed_joint" type="fixed">
        <parent link="base_link"/>
        <child link="zed_camera_link"/>
        <origin xyz="${zed_x} ${zed_y} ${zed_z}" rpy="0 0 0"/>
    </joint>

    <link name="zed_camera_link">
        <visual>
            <geometry>
                <box size="0.033 0.175 0.030"/>
            </geometry>
            <material name="zed_black">
                <color rgba="0.1 0.1 0.1 1"/>
            </material>
        </visual>
    </link>

</robot>
