<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="kahuil_tracked">

    <xacro:arg name="use_ros2_control" default="true"/>
    <xacro:arg name="sim_mode" default="false"/>

    <xacro:include filename="kahuil_tracked_core.xacro" />

    <xacro:if value="$(arg use_ros2_control)">
        <xacro:include filename="kahuil_tracked_ros2_control.xacro"/>
    </xacro:if>

    <xacro:unless value="$(arg use_ros2_control)">
        <xacro:include filename="kahuil_tracked_gazebo.xacro"/>
    </xacro:unless>

    <xacro:include filename="lidar.xacro"/>

    <xacro:include filename="depth_camera.xacro"/>

    <xacro:include filename="zed.xacro"/>

</robot>
